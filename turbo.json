{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CONTACT_WEBHOOK_URL",
    "CONTACT_WEBHOOK_SECRET",
    "CONTACT_CLIENT_FINGERPRINT_SECRET",
    "CONTACT_RATE_LIMIT_MAX",
    "CONTACT_ATTRIBUTION_ENABLED",
    "CONTACT_RECIPIENT_EMAIL",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "TURNSTILE_SECRET_KEY",
    "TURNSTILE_EXPECTED_HOSTNAMES",
    "NODE_ENV"
  ],
  "globalPassThroughEnv": [
    "API_VERSION",
    "PORT",
    "SERVER_URL",
    "CONSOLE_URL",
    "WEB_URL",
    "DOCS_URL",
    "CORS_ORIGINS",
    "DATABASE_URL",
    "REDIS_URL",
    "AGENT_DELETION_RECOVERY_INTERVAL_MS",
    "RATE_LIMIT_STORE",
    "TRUSTED_PROXY_CIDRS",
    "LIVE_TRANSCRIPT_TTL_SECONDS",
    "WIDGET_ASSET_DIR",
    "WIDGET_SESSION_TTL_SECONDS",
    "WIDGET_RATE_LIMIT_WINDOW_SECONDS",
    "WIDGET_RATE_LIMIT_MAX_SESSIONS",
    "WIDGET_MAX_CONCURRENT_SESSIONS_PER_WIDGET",
    "WIDGET_ALLOW_LOCALHOST_ORIGINS",
    "READINESS_REQUIRED_INTEGRATIONS",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_SECRET",
    "INTERNAL_API_KEY",
    "AI_API_URL",
    "SECRET_ENCRYPTION_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "LIVEKIT_URL",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "LIVEKIT_SIP_INBOUND_TRUNK_ID",
    "LIVEKIT_SIP_OUTBOUND_TRUNK_TWILIO_ID",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_TRUNK_SID",
    "TELNYX_API_KEY",
    "TELNYX_CONNECTION_ID",
    "TELNYX_BILLING_CURRENCY",
    "RECORDING_STORAGE",
    "RECORDING_LOCAL_DIR",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "S3_BUCKET_NAME",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "STRIPE_WALLET_WEBHOOK_SECRET",
    "QUICKVOICE_BILLING_MODE",
    "BILLING_PROMO_START_AT",
    "NUMBER_QUOTE_SIGNING_SECRET",
    "PROMOTIONAL_IDENTITY_SECRET",
    "STRIPE_AUTOMATIC_TAX_ENABLED",
    "STRIPE_WALLET_TAX_CODE",
    "INNGEST_SIGNING_KEY",
    "INNGEST_SERVE_ORIGIN",
    "INNGEST_SERVE_PATH",
    "TRANSCRIPT_RETENTION_DAYS",
    "RECORDING_RETENTION_DAYS",
    "MCP_LOG_RETENTION_DAYS",
    "FAILED_KB_RETENTION_DAYS",
    "RETENTION_CLEANUP_BATCH_SIZE",
    "KB_MAX_UPLOAD_BYTES",
    "OUTBOUND_BATCH_MAX_UPLOAD_BYTES",
    "OUTBOUND_BATCH_MAX_RECIPIENTS",
    "OUTBOUND_BATCH_DISPATCH_POLL_MS",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USERNAME",
    "SMTP_PASSWORD",
    "FROM_EMAIL",
    "ZEPTOMAIL_TOKEN",
    "ZEPTOMAIL_URL",
    "PROVIDER_SPEND_ALERTS_ENABLED",
    "PROVIDER_SPEND_ALERT_RECIPIENTS",
    "PROVIDER_SPEND_MONITORS",
    "DEEPGRAM_SPEND_API_KEY",
    "AWS_SPEND_ACCESS_KEY_ID",
    "AWS_SPEND_SECRET_ACCESS_KEY",
    "AWS_SPEND_SESSION_TOKEN",
    "COMPOSIO_API_KEY",
    "COMPOSIO_AUTH_CONFIGS",
    "BILLING_PRICING_MODE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
